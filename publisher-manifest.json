m;width:8px;height:1px;background:var(--mint-deep)}\n  .plans-note{margin:36px 0 0;padding:18px 0 0;border-top:1px solid var(--line);font-size:13px;color:var(--muted);max-width:52em}\n\n  /* 使用说明 */\n  .steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:44px}\n  .step h3{margin:0 0 8px;font-size:15.5px;color:var(--brown)}\n  .step .num{font-size:12px;letter-spacing:.16em;color:var(--mint-deep);display:block;margin-bottom:10px;font-weight:600}\n  .step p{margin:0;font-size:14.5px;color:#4c3f36}\n\n  /* 客户端 */\n  .clients{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 52px}\n  .client h3{margin:0 0 6px;font-size:16.5px;color:var(--brown)}\n  .client p{margin:0;font-size:14.5px;color:#4c3f36}\n  .client .avail{display:inline-block;margin-top:10px;font-size:12px;letter-spacing:.06em;color:var(--brown-soft);border-bottom:1px solid var(--line);padding-bottom:2px}\n\n  /* FAQ details 折叠 */\n  .faq{max-width:56em}\n  .faq details{border-top:1px solid var(--line);padding:18px 0}\n  .faq details:first-of-type{border-top:none;padding-top:0}\n  .faq summary{cursor:pointer;font-size:16px;font-weight:600;color:var(--brown);list-style:none;display:flex;justify-content:space-between;gap:20px;align-items:flex-start}\n  .faq summary::-webkit-details-marker{display:none}\n  .faq summary::after{content:\"＋\";color:var(--mint-deep);font-weight:400;flex:0 0 auto;line-height:1.4}\n  .faq details[open] summary::after{content:\"－\"}\n  .faq .answer{margin:14px 0 2px;font-size:14.5px;color:#4c3f36;max-width:48em}\n  .faq .answer p{margin:0 0 10px}\n  .faq .answer p:last-child{margin-bottom:0}\n\n  /* 底部 */\n  footer{background:var(--brown);color:#d8cabb;padding:44px 0 52px;font-size:13.5px}\n  footer .wrap{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:flex-start}\n  footer strong{color:var(--mint);letter-spacing:.12em;font-weight:700}\n  footer p{margin:8px 0 0;max-width:36em;line-height:1.7}\n  footer nav{display:flex;gap:20px;flex-wrap:wrap}\n  footer a{color:#d8cabb;text-decoration:none;border-bottom:1px solid #5b4535;padding-bottom:2px}\n  footer a:hover,footer a:focus{color:var(--mint);border-bottom-color:var(--mint)}\n\n  @media (max-width:860px){\n    .hero .wrap{grid-template-columns:1fr;gap:40px}\n    .plan{grid-template-columns:1fr;gap:18px}\n    .steps{grid-template-columns:1fr;gap:32px}\n    .clients{grid-template-columns:1fr;gap:28px}\n  }\n  @media (max-width:520px){\n    .wrap{padding:0 18px}\n    .hero{padding:44px 0 52px}\n    section{padding:46px 0}\n    .topnav{gap:14px;font-size:13px}\n    .panel{padding:24px 20px 20px}\n    .price{font-size:25px}\n  }\n</style><header class=\"topbar\">\n  <div class=\"wrap\">\n    <a class=\"brandmark\" href=\"#top\">xiao<span>yang</span></a>\n    <nav class=\"topnav\" aria-label=\"页面目录\">\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main id=\"top\">\n\n  <section class=\"hero\">\n    <div class=\"wrap\">\n      <div>\n        <p class=\"eyebrow\">服务说明 · 2568</p>\n        <h1 id=\"hero-title\">xiaoyang<em>把套餐讲清楚再谈选择</em></h1>\n        <p class=\"lede\">\n          这一页只做一件事：把 xiaoyang 的档位、价格、额度与设备上限逐条写在明面上，\n          并说明开通之后怎么用、哪些情况需要你在自己这一侧确认。没有隐藏的加量包，\n          也没有写在细则末尾的附加条件。\n        </p>\n        <div class=\"hero-meta\">\n          <span>三档订阅</span>\n          <span>月付 / 年付</span>\n          <span>额度按自然月重置</span>\n          <span>说明以本页为准</span>\n        </div>\n      </div>\n\n      <aside class=\"panel\">\n        <h2 id=\"panel-title\">快速对照</h2>\n        <p class=\"panel-sub\">下表为各档位的核心参数，详细权益见套餐章节。</p>\n        <dl>\n          <div class=\"row\">\n            <dt>基础版</dt>\n            <dd>¥15/月</dd>\n          </div>\n          <div class=\"row\">\n            <dt>旗舰版</dt>\n            <dd>¥35/月</dd>\n          </div>\n          <div class=\"row\">\n            <dt>团队版</dt>\n            <dd>¥85/月</dd>\n          </div>\n          <div class=\"row\">\n            <dt>设备上限</dt>\n            <dd>3 / 5 / 20 台</dd>\n          </div>\n          <div class=\"row\">\n            <dt>年付折算</dt>\n            <dd>¥150 / ¥350 / ¥850</dd>\n          </div>\n        </dl>\n        <p class=\"panel-foot\">\n          年付按十个月计费，对应有效期十二个月。价格与额度以本页所列内容为准，\n          未在本页出现的权益不作承诺。\n        </p>\n      </aside>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"kicker\">订阅档位</p>\n        <h2 id=\"plans-title\">三档之间只有三处差异：流量、设备数、支持方式</h2>\n        <p>\n          每档按月计费，年付为一次性支付十个月的费用。选择时先确认三件事：\n          你一个月大约用多少流量、同时在线几台设备、出现问题时需要多快的回应。\n        </p>\n      </div>\n\n      <div class=\"plans\">\n\n        <article class=\"plan\">\n          <div>\n            <h3>基础版</h3>\n            <p class=\"price\">¥15/月<small>按年付仅需 ¥150/年</small></p>\n          </div>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>基础流媒体解锁范围</li>\n            <li>常规线路池，不含专线</li>\n            <li>工单支持，按提交顺序处理</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <h3>旗舰版<span class=\"tag\">多数人适用</span></h3>\n            <p class=\"price\">¥35/月<small>按年付仅需 ¥350/年</small></p>\n          </div>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全线路流媒体解锁范围</li>\n            <li>含专线线路，用于游戏与实时会议</li>\n            <li>优先工单支持，7×24 小时受理</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <h3>团队版</h3>\n            <p class=\"price\">¥85/月<small>按年付仅需 ¥850/年</small></p>\n          </div>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>高带宽线路组，单独分配</li>\n            <li>可提交定制路由需求</li>\n            <li>专属对接人，处理账号与用量问题</li>\n          </ul>\n        </article>\n\n      </div>\n\n      <p class=\"plans-note\">\n        说明：以上额度均为每月上限，不累积、不结转到下个月。设备数以“同一时间在线”为计，\n        不是历史登录总数。若你需要超出团队版的额度或设备数，请先通过工单说明规模，\n        我们不会在未确认的情况下默认接受。\n      </p>\n    </div>\n  </section>\n\n  <section id=\"usage\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"kicker\">使用说明</p>\n        <h2 id=\"usage-title\">从选择到日常使用，分三步</h2>\n        <p>以下顺序适用于三档订阅。每一步都不需要额外付费，也不需要安装本页之外的组件。</p>\n      </div>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <span class=\"num\">步骤 01</span>\n          <h3>先定档位，再定周期</h3>\n          <p>\n            按上文的流量与设备数选择档位。第一次使用建议先按月付，\n            用满一个自然月后再决定是否改为年付。年付一旦生效，中途降档不会退还差额。\n          </p>\n        </div>\n        <div class=\"step\">\n          <span class=\"num\">步骤 02</span>\n          <h3>在客户端内导入配置</h3>\n          <p>\n            开通后你会得到一份账号信息。请在客户端中手动填入或导入，\n            不要把它转发给他人。设备数上限按同时在线计算，超出的设备会被挤下线。\n          </p>\n        </div>\n        <div class=\"step\">\n          <span class=\"num\">步骤 03</span>\n          <h3>按需切换线路并观察用量</h3>\n          <p>\n            日常浏览使用常规线路即可；游戏、会议等对时延敏感的场景，\n            旗舰版与团队版可切换到专线或高带宽线路组。用量在账号页按月显示。\n          </p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"kicker\">客户端</p>\n        <h2 id=\"clients-title\">客户端由你自己选择，我们不捆绑安装包</h2>\n        <p>\n          xiaoyang 提供账号与线路信息，不强制指定某一款客户端。\n          下面列出常见的接入方式与注意事项；具体下载请以对应项目的官方发布页为准，\n          本页不提供安装包下载地址。\n        </p>\n      </div>\n\n      <div class=\"clients\">\n        <div class=\"client\">\n          <h3>桌面端</h3>\n          <p>\n            在 Windows 与 macOS 上，可使用支持手动导入配置的通用客户端。\n            导入后建议先测一次延迟，再决定日常使用哪条线路。\n          </p>\n          <span class=\"avail\">下载地址：请前往对应客户端官方渠道获取</span>\n        </div>\n        <div class=\"client\">\n          <h3>移动端</h3>\n          <p>\n             iOS 与 Android 上同样使用通用客户端接入。移动网络切换较频繁，\n            若出现断连，先检查系统是否限制了后台运行。\n          </p>\n          <span class=\"avail\">下载地址：请前往对应客户端官方渠道获取</span>\n        </div>\n        <div class=\"client\">\n          <h3>路由器与多人环境</h3>\n          <p>\n            团队版可提交定制路由需求，用于多人共用同一出口的场景。\n            是否适合在路由器上部署，取决于你使用的固件与设备性能，需自行评估。\n          </p>\n          <span class=\"avail\">部署方式：以工单确认后的说明为准</span>\n        </div>\n        <div class=\"client\">\n          <h3>账号与设备管理</h3>\n          <p>\n            同时在线设备数按档位限制。更换设备前请先在旧设备上退出，\n            避免占用名额导致新设备无法接入。\n          </p>\n          <span class=\"avail\">额度与设备数：见套餐章节</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"kicker\">常见问题</p>\n        <h2 id=\"faq-title\">开通前后最常被问到的几件事</h2>\n        <p>以下回答只针对本页所列的三档订阅，未涉及的情况请通过工单确认。</p>\n      </div>\n\n      <div class=\"faq\">\n\n        <details>\n          <summary>月付和年付在权益上有什么区别？</summary>\n          <div class=\"answer\">\n            <p>\n              没有区别。年付只是把计费周期拉长：一次性支付十个月的费用，获得十二个月的有效期。\n              流量额度、设备上限、线路范围与支持方式均与同档位的月付一致。\n            </p>\n            <p>\n              基础版年付 ¥150，旗舰版年付 ¥350，团队版年付 ¥850。年付生效后不支持按月退回剩余部分。\n            </p>\n          </div>\n        </details>\n\n        <details>\n          <summary>流量额度用完了会怎样？</summary>\n          <div class=\"answer\">\n            <p>\n              当月额度用尽后，该计费周期内不再提供新的流量，直到下一个自然月重置。\n              额度不累积，也不会自动转成付费加量包。\n            </p>\n            <p>\n              如果你长期接近上限，说明当前档位偏小，建议在下一个计费周期开始前调整到更高一档。\n            </p>\n          </div>\n        </details>\n\n        <details>\n          <summary>三档的“解锁”范围具体指什么？</summary>\n          <div class=\"answer\">\n            <p>\n              基础版为常规线路池所支持的流媒体范围；旗舰版与团队版覆盖全线路的流媒体范围。\n              具体某个平台是否可用，取决于该平台当时的策略与线路状态，\n              本页不做逐一承诺。\n            </p>\n          </div>\n        </details>\n\n        <details>\n          <summary>设备数是怎么计算的？换手机需要重新付费吗？</summary>\n          <div class=\"answer\">\n            <p>\n              按同一时刻在线的设备数量计算，不按历史登录总数。更换设备时，\n              先在旧设备上退出登录，新设备即可占用同一名额，不需要重新付费。\n            </p>\n            <p>\n              基础版 3 台、旗舰版 5 台、团队版 20 台。超出上限时，最早在线的设备会被挤下线。\n            </p>\n          </div>\n        </details>\n\n        <details>\n          <summary>专线线路适合什么场景？</summary>\n          <div class=\"answer\">\n            <p>\n              专线主要用于对时延和抖动敏感的场景，例如实时对战类游戏、视频会议与远程协作。\n              普通网页浏览与文件传输使用常规线路即可，没有必要占用专线。\n            </p>\n            <p>\n              旗舰版含专线线路，团队版使用独立分配的高带宽线路组。基础版不含专线。\n            </p>\n          </div>\n        </details>\n\n        <details>\n          <summary>支持方式有多快？</summary>\n          <div class=\"answer\">\n            <p>\n              三档均通过工单受理问题。基础版按提交顺序处理，旗舰版为优先受理并 7×24 小时接收工单，\n              团队版由专属对接人处理账号与用量相关事项。\n            </p>\n            <p>\n              本页不对具体响应时长做时间承诺；如遇线路整体异常，会在工单中统一说明进展。\n            </p>\n          </div>\n        </details>\n\n        <details>\n          <summary>本页为什么没有提供下载链接？</summary>\n          <div class=\"answer\">\n            <p>\n              xiaoyang 不发布也不托管客户端安装包，接入使用的是通用客户端。\n              为避免让你安装到来源不明的文件，本页只说明接入方式，不给出下载地址。\n            </p>\n            <p>\n              请从对应客户端项目的官方渠道获取安装包，并在导入前核对来源。\n            </p>\n          </div>\n        </details>\n\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div>\n      <strong>xiaoyang</strong>\n      <p>\n        本页为订阅与服务说明，内容以本页文字为准。价格、额度与设备上限如有调整，\n        会在下一计费周期开始前于本页更新。\n      </p>\n    </div>\n    <nav aria-label=\"页脚目录\">\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#top\">回到顶部</a>\n    </nav>\n  </div>\n</footer>",
